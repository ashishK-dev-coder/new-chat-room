# Vercel & Production Environment Variable Example
# Add these environment variables in Vercel:
# Project Settings -> Environment Variables

# 1. Author 1 and Author 2 Separate Passwords
AUTHOR_1_PASSWORD=your_author_1_password_here
AUTHOR_2_PASSWORD=your_author_2_password_here

# 2. Upstash Redis (For sub-20ms instant delivery across laptops/mobiles on Vercel)
# Get free credentials at: https://console.upstash.com -> REST API
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 3. Cloudinary (Optional: For Ephemeral Snap Photo Uploads & Destruction)
# If not provided, snap feature uses ephemeral in-memory storage automatically
CLOUDINARY_CLOUD_NAME=dwrpegrcg
CLOUDINARY_API_KEY=765717958771634
CLOUDINARY_API_SECRET=ZEN-6lS4PrroZ9qXgDVRoLn5aDI
# Optional unsigned preset
# CLOUDINARY_UPLOAD_PRESET=chat_snaps
